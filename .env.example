# Frontend (hosted Supabase deploy). Leave unset for local development —
# the Vite dev proxy then forwards auth/rest to http://localhost:54321.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: override the local backend target used by the Vite proxy.
VITE_LOCAL_BACKEND_URL=http://localhost:54321
